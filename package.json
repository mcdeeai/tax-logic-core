{
    "name": "tax-logic-core",
    "version": "1.0.0",
    "description": "Open-source US federal and state tax calculation engine with optimization strategies. Community-auditable tax logic with IRS citations.",
    "main": "src/index.js",
    "module": "src/index.js",
    "type": "module",
    "exports": {
        ".": "./src/index.js",
        "./calculations": "./src/calculations/index.js",
        "./optimizations": "./src/optimizations/index.js",
        "./authority": "./src/utils/taxAuthority.js"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src/ tests/",
        "check:exports": "node scripts/check-exports.mjs"
    },
    "keywords": [
        "tax",
        "1040",
        "irs",
        "tax-calculator",
        "federal-tax",
        "state-tax",
        "tax-optimization",
        "qbi",
        "capital-gains",
        "amt",
        "augusta-rule",
        "open-source"
    ],
    "author": "TaxOptimizer Community",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/rsathyam/tax-logic-core.git"
    },
    "bugs": {
        "url": "https://github.com/rsathyam/tax-logic-core/issues"
    },
    "homepage": "https://github.com/rsathyam/tax-logic-core#readme",
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "vitest": "^2.0.0"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "packageManager": "bun@1.3.14"
}
